{
  "manifest_version": 3,
  "name": "Blue Letter Bible Suite",
  "version": "5.2.51.46",
  "description": "Bible study tools for BLB search, Bible references, Show on BLB, Double-Click BLB, and KJV case-sensitive search.",
  "permissions": [
    "clipboardWrite",
    "tabs",
    "omnibox",
    "storage",
    "downloads",
    "declarativeNetRequest",
    "contextMenus",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "omnibox": {
    "keyword": "b"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*.pdf",
        "file:///*.html",
        "file:///*.htm"
      ],
      "js": [
        "multiverse-bootstrap-guard.js",
        "kjv-corpus-word-index.js",
        "books.js",
        "book-aliases.js",
        "reference-core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-bible-selection-in-blb": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open selected Bible text or references in BLB"
    }
  },
  "action": {
    "default_title": "BLB Suite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
