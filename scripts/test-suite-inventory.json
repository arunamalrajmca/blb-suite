{
  "schemaVersion": 1,
  "description": "Patterns are discovered dynamically; every suite declares its default execution environment, and genuinely native browser cases are delegated to one X11 owner.",
  "suites": [
    {
      "id": "playwright-browser-specs",
      "pattern": "tests/browser/*.spec.js",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "npx playwright test --list",
      "delegations": [
        {
          "testTitle": "a real MV3 service-worker termination is recovered by the physical Alt+B browser shortcut",
          "workflow": ".github/workflows/browser-native-shortcut.yml",
          "requiredText": "tests/browser/service-worker-shortcut-headed.spec.js",
          "testFile": "tests/browser/service-worker-shortcut-headed.spec.js",
          "environment": "x11-headed-chromium"
        },
        {
          "testTitle": "native Chromium _self prerender activation initializes the activated document without tab replacement",
          "workflow": ".github/workflows/browser-native-shortcut.yml",
          "requiredText": "tests/browser/native-prerender-activation.spec.js",
          "testFile": "tests/browser/native-prerender-activation.spec.js",
          "environment": "x11-headed-chromium",
          "testTitlePattern": "native Chromium .* prerender activation initializes the activated document without tab replacement"
        },
        {
          "testTitle": "native Chromium _blank prerender activation initializes the activated document without tab replacement",
          "workflow": ".github/workflows/browser-native-shortcut.yml",
          "requiredText": "tests/browser/native-prerender-activation.spec.js",
          "testFile": "tests/browser/native-prerender-activation.spec.js",
          "environment": "x11-headed-chromium",
          "testTitlePattern": "native Chromium .* prerender activation initializes the activated document without tab replacement"
        },
        {
          "testTitle": "Show on BLB performance benchmark",
          "workflow": ".github/workflows/browser-e2e-performance.yml",
          "requiredText": "tests/browser/performance.spec.js",
          "testFile": "tests/browser/performance.spec.js",
          "environment": "dedicated-performance-runner"
        },
        {
          "testTitle": "Interleaved baseline/candidate performance batch preserves isolated samples",
          "workflow": ".github/workflows/browser-e2e-performance.yml",
          "requiredText": "tests/browser/performance-batch.spec.js",
          "testFile": "tests/browser/performance-batch.spec.js",
          "environment": "dedicated-performance-runner"
        }
      ],
      "executionEnvironment": "headless Chromium by default; only native browser UI/activation cases use headed Chromium under Xvfb/X11",
      "runnerChecks": [
        {
          "file": ".github/workflows/experimental-full-audit-concurrency-equivalence.yml",
          "requiredText": "node scripts/compare-full-audit-concurrency.mjs"
        },
        {
          "file": ".github/workflows/experimental-master-toggle-registration-diagnostics.yml",
          "requiredText": "current-tab activation falls back when persistent content-script registration fails"
        },
        {
          "file": "tests/browser/site-registration-opt-out-race.spec.js",
          "requiredText": "master OFF-to-ON recovery repairs registrations"
        },
        {
          "file": "tests/browser/source-page-button-redirect-separation.spec.js",
          "requiredText": "BLB_MASTER_TOGGLE_TRACE"
        },
        {
          "file": "extension/background.js",
          "requiredText": "const response = await chrome.tabs.sendMessage(tabId, {type:'blbSuiteRefreshSiteFeatures'});"
        },
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "group: full-test-audit-${{ github.event.pull_request.number || github.ref }}-${{ github.event.label.name || github.event.action || 'dispatch' }}"
        },
        {
          "file": ".github/workflows/experimental-full-audit-concurrency-equivalence.yml",
          "requiredText": "group: full-audit-concurrency-equivalence-${{ github.event.pull_request.number || github.ref }}"
        },
        {
          "file": ".github/workflows/experimental-master-toggle-registration-diagnostics.yml",
          "requiredText": "github.event.label.name || github.event.action || 'dispatch'"
        }
      ]
    },
    {
      "id": "selector-contract-tests",
      "pattern": "tests/selector/*.test.mjs",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "node --test tests/selector/*.test.mjs",
      "executionEnvironment": "node"
    },
    {
      "id": "ast-reachability-audit-tests",
      "pattern": "scripts/ast-*-audit.test.js",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "for test_file in scripts/ast-*-audit.test.js",
      "alsoOwnedBy": ".github/workflows/browser-tests.yml",
      "alsoRequiredText": "node --test scripts/ast-symbol-reference-audit.test.js",
      "runnerChecks": [
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "node --test \"$test_file\""
        },
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "audit_file=\"${test_file%.test.js}.js\""
        },
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "node scripts/verify-ast-audit-concurrency-equivalence.mjs --workers=4"
        },
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "AST_CONCURRENCY"
        },
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "for audit_file in scripts/ast-*-audit.js"
        },
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "if [[ ! -f \"$test_file\" ]]; then"
        }
      ],
      "executionEnvironment": "node"
    },
    {
      "id": "standalone-javascript-tests",
      "pattern": "scripts/test-*.js",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "for test_file in scripts/test-*.js",
      "runnerChecks": [
        {
          "file": "scripts/run-validation-tests.js",
          "requiredText": "validation-test-manifest.json"
        },
        {
          "file": "scripts/validate-build.js",
          "requiredText": "runValidationTests"
        }
      ],
      "executionEnvironment": "node"
    },
    {
      "id": "python-unittests",
      "pattern": "tests/test_*.py",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "python -m unittest discover -s tests -p 'test_*.py' -v",
      "executionEnvironment": "python"
    },
    {
      "id": "deterministic-regression-groups",
      "pattern": "regression-suite/tests/*-tests.mjs",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "node regression-suite/tests/run-regression.mjs extension --group=",
      "runnerFile": "regression-suite/tests/run-regression.mjs",
      "runnerImportPrefix": "from './",
      "executionEnvironment": "node"
    },
    {
      "id": "kjv-corpus-integrity",
      "pattern": "regression-suite/tests/kjv-corpus-integrity.mjs",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "node regression-suite/tests/kjv-corpus-integrity.mjs extension",
      "executionEnvironment": "node"
    },
    {
      "id": "inventory-enforcement-checker",
      "pattern": "scripts/test-suite-inventory.mjs",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "node scripts/test-suite-inventory.mjs",
      "executionEnvironment": "node"
    },
    {
      "id": "full-audit-checkpoint-validator-tests",
      "pattern": "scripts/full-audit-checkpoint-validation.test.mjs",
      "owner": ".github/workflows/experimental-full-audit-concurrency-equivalence.yml",
      "requiredText": "node --test scripts/full-audit-checkpoint-validation.test.mjs",
      "executionEnvironment": "node"
    },
    {
      "id": "ci-section-checkpoint-tests",
      "pattern": "scripts/ci-section-checkpoint.test.mjs",
      "owner": ".github/workflows/browser-tests.yml",
      "requiredText": "node --test scripts/ci-section-checkpoint.test.mjs",
      "executionEnvironment": "node",
      "runnerChecks": [
        {
          "file": ".github/actions/ci-section-checkpoint/action.yml",
          "requiredText": "actions/cache/restore@v5"
        },
        {
          "file": ".github/actions/ci-section-checkpoint/action.yml",
          "requiredText": "actions/cache/save@v5"
        },
        {
          "file": ".github/workflows/browser-tests.yml",
          "requiredText": "ci-section-checkpoint"
        }
      ]
    },
    {
      "id": "checkpointed-browser-audit-runner-tests",
      "pattern": "scripts/run-checkpointed-playwright-audit.test.mjs",
      "owner": ".github/workflows/manual-full-test-audit.yml",
      "requiredText": "node --test scripts/ci-section-checkpoint.test.mjs scripts/run-checkpointed-playwright-audit.test.mjs",
      "executionEnvironment": "node",
      "runnerChecks": [
        {
          "file": ".github/workflows/manual-full-test-audit.yml",
          "requiredText": "node scripts/run-checkpointed-playwright-audit.mjs \"$test_list\""
        },
        {
          "file": ".github/actions/ci-section-checkpoint/action.yml",
          "requiredText": "BLB_CI_CHECKPOINT_FINGERPRINT"
        }
      ]
    },
    {
      "id": "checkpointed-playwright-repeat-runner-tests",
      "pattern": "scripts/run-checkpointed-playwright-repeats.test.mjs",
      "owner": ".github/workflows/experimental-master-toggle-registration-diagnostics.yml",
      "requiredText": "node --test scripts/run-checkpointed-playwright-repeats.test.mjs",
      "executionEnvironment": "node",
      "runnerChecks": [
        {
          "file": ".github/workflows/experimental-master-toggle-registration-diagnostics.yml",
          "requiredText": "node scripts/run-checkpointed-playwright-repeats.mjs"
        },
        {
          "file": ".github/actions/ci-section-checkpoint/action.yml",
          "requiredText": "always-run"
        }
      ]
    }
  ],
  "manualOnly": [
    {
      "path": "local-runner/BLB-Test.bat",
      "reason": "Interactive local Brave test launcher; not an automated CI suite."
    },
    {
      "path": "local-runner/Legacy-Brave-E2E-Runner/BLB-Test.bat",
      "reason": "Legacy interactive Brave test launcher; not an automated CI suite."
    },
    {
      "path": "local-runner/Legacy-Brave-E2E-Runner/test-runner.ps1",
      "reason": "Legacy interactive Brave test harness; not an automated CI suite."
    },
    {
      "path": "regression-suite/Run-BLB-Regression.ps1",
      "reason": "PowerShell wrapper for the deterministic regression suite; the underlying Node regression groups are executed by the full audit."
    }
  ],
  "manualVerification": "PRE-MERGE-CHECKLIST.md remains the source of required manual Brave/Chrome verification for native context menus, browser-specific permissions, and protected PDF behavior.",
  "productionCoverage": [
    {
      "id": "mv3-worker-lifecycle-and-recovery",
      "productionFiles": [
        "extension/background.js",
        "extension/manifest.json"
      ],
      "testFiles": [
        {
          "path": "tests/browser/service-worker-lifecycle.spec.js",
          "requiredText": [
            "a real MV3 service-worker termination is recovered by a content-script selection request",
            "a terminated worker reconciles stale host registrations and expires pending intents on its next real activation",
            "browser restart reconciles persisted host registrations and pending permission intents using the same profile",
            "selection runtime messages survive repeated transient No SW dispatch failures"
          ]
        }
      ]
    },
    {
      "id": "reference-resolution-and-four-user-actions",
      "productionFiles": [
        "extension/content.js",
        "extension/reference-core.js",
        "extension/books.js"
      ],
      "testFiles": [
        {
          "path": "tests/browser/extension-reference-actions.spec.js",
          "requiredText": [
            "Single-word verse cues resolve the same adjacent passage through all four actions",
            "all 66 canonical book suffixes resolve through all four actions with both separators",
            "Double-click generic reference grammar — exhaustive token coverage — OT and NT",
            "Same-chapter ranges — all 66 books through "
          ]
        }
      ]
    },
    {
      "id": "site-registration-and-source-page-activation",
      "productionFiles": [
        "extension/background.js",
        "extension/content.js",
        "extension/manifest.json"
      ],
      "testFiles": [
        {
          "path": "tests/browser/site-registration-opt-out-race.spec.js",
          "requiredText": [
            "rapid site opt-out waits for an older registration reconciliation before unregistering",
            "master OFF-to-ON recovery repairs registrations after an older tab activation finishes",
            "a failed in-flight activation does not suppress a fresh eligible current-tab fallback"
          ]
        },
        {
          "path": "tests/browser/source-page-button-redirect-separation.spec.js",
          "requiredText": [
            "every shared-registry page-button host shows the exact button on content pages and excludes homepages",
            "registered source-page collector remains available regardless of redirect preference",
            "Suite master opt-out removes both registered worlds for guarded source hosts and re-enable restores them"
          ]
        }
      ]
    },
    {
      "id": "multiverse-tab-state-and-handoff",
      "productionFiles": [
        "extension/background.js",
        "extension/content.js"
      ],
      "testFiles": [
        {
          "path": "tests/browser/service-worker-lifecycle.spec.js",
          "requiredText": [
            "a replaced MV3 tab migrates extension-owned destination and MultiVerse state",
            "closing multiple MultiVerse tabs concurrently removes every persisted tab record",
            "a MultiVerse link opened from BLB in a new tab defaults to Tool View on first load"
          ]
        }
      ]
    }
  ]
}
